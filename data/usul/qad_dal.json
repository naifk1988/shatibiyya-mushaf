 "bayts": [
  {
   "no": 262,
   "text": "وَقَدْ سَحَبَتْ ذَيْلًا ضَفَا ظَلَّ زَرْنَبٌ ... جَلَتْهُ صَبَاهُ شَائِقًا وَمُعَلَّلَا"
  },
  {
   "no": 263,
   "text": "فَأَظْهَرَهَا نَجْمٌ بَدَا دَلَّ وَاضِحًا ... وَأَدْغَمَ وَرْشٌ ضَرَّ ظَمْآنَ وَامْتَلَا"
  },
  {
   "no": 264,
   "text": "وَأَدْغَمَ مُرْوٍ وَاكِفٌ ضَيْرَ ذَابِلٍ ... زَوَى ظِلَّهُ وَغْرٌ تَسَدَّاهُ كَلْكَلَا"
  },
  {
   "no": 265,
   "text": "وَفِي حَرْفِ زَيَّنَّا خِلَافٌ وَمُظْهِرٌ ... هِشَامٌ بِصَادٍ حَرْفَهُ مُتَحَمِّلَا"
  }
 ],
